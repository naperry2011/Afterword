<?xml version="1.0" encoding="utf-8"?>
<!-- Pixel lamp, same art as the iOS icon. The foreground already carries the
     room colour, so any launcher mask shape crops into the same dark field. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/room" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
